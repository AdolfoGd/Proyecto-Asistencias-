@model Application.DTOs.GruposDTO
@{
    ViewData["Title"] = "Editar Grupo";
}

<div class="container my-5 d-flex justify-content-center">
    <div class="card border-0 shadow-lg p-4 rounded-3" style="background-color: #1e293b; max-width: 600px; width: 100%;">
        <h3 class="text-white fw-bold mb-1">Editar Grupo</h3>
        <p class="text-muted small mb-4">Actualiza la asignatura, docente o sección del grupo</p>

        <div asp-validation-summary="All" class="alert alert-danger border-0 shadow-sm mb-3"></div>

        <form asp-action="Editar" method="post">
            <!-- Campo oculto indispensable -->
            <input type="hidden" asp-for="CodigoGrupo" />

            <div class="row g-3">
                <div class="col-md-6 mb-3">
                    <label asp-for="CodigoGrupo" class="form-label text-light fw-semibold">Código de Grupo</label>
                    <input asp-for="CodigoGrupo" class="form-control text-white" style="background-color: #0f172a; border-color: #334155;" required />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Seccion" class="form-label text-light fw-semibold">Sección</label>
                    <input asp-for="Seccion" class="form-control text-white" style="background-color: #0f172a; border-color: #334155;" required />
                    <span asp-validation-for="Seccion" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-6 mb-3">
                    <label asp-for="IdAsignatura" class="form-label text-light fw-semibold">ID Asignatura</label>
                    <input asp-for="IdAsignatura" class="form-control text-white" style="background-color: #0f172a; border-color: #334155;" required />
                    <span asp-validation-for="IdAsignatura" class="text-danger small"></span>
                </div>

                <div class="col-md-6 mb-4">
                    <label asp-for="IdDocente" class="form-label text-light fw-semibold">ID Docente</label>
                    <input asp-for="IdDocente" class="form-control text-white" style="background-color: #0f172a; border-color: #334155;" required />
                    <span asp-validation-for="IdDocente" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-2">
                <a asp-action="Index" class="btn btn-outline-light px-4 fw-semibold">Cancelar</a>
                <button type="submit" class="btn btn-warning px-4 fw-semibold text-dark">Guardar Cambios</button>
            </div>
        </form>
    </div>
</div>
