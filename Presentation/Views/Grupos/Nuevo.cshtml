@model Domain.Entities.Grupos

@{
    ViewData["Title"] = "Registrar Grupo";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-0"><i class="bi bi-folder-plus text-warning me-2"></i>Registrar Nuevo Grupo</h2>
        <p class="text-muted fs-6 mb-0">Ingrese los datos para aperturar una nueva sección o grupo de clases.</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3 bg-white">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">

                <!-- Código de Grupo -->
                <div class="col-md-6">
                    <label asp-for="CodigoGrupo" class="form-label fw-semibold text-secondary">Código del Grupo</label>
                    <input asp-for="CodigoGrupo" type="text" class="form-control" placeholder="Ej. GRP-2024-01" required />
                    <span asp-validation-for="CodigoGrupo" class="text-danger small"></span>
                </div>

                <!-- ID Asignatura -->
                <div class="col-md-6">
                    <label asp-for="IdAsignatura" class="form-label fw-semibold text-secondary">Id de la Asignatura</label>
                    <input asp-for="IdAsignatura" type="number" class="form-control" placeholder="Ej. 101" required />
                    <span asp-validation-for="IdAsignatura" class="text-danger small"></span>
                </div>

                <!-- ID Docente -->
                <div class="col-md-6">
                    <label asp-for="IdDocente" class="form-label fw-semibold text-secondary">Id / Carnet del Docente</label>
                    <input asp-for="IdDocente" type="text" class="form-control" placeholder="Ej. D-240101" required />
                    <span asp-validation-for="IdDocente" class="text-danger small"></span>
                </div>

                <!-- Sección -->
                <div class="col-md-6">
                    <label asp-for="Seccion" class="form-label fw-semibold text-secondary">Sección</label>
                    <input asp-for="Seccion" type="text" class="form-control" placeholder="Ej. 1M1-CO" required />
                    <span asp-validation-for="Seccion" class="text-danger small"></span>
                </div>

            </div>

            <hr class="my-4 text-muted" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning fw-bold px-4">
                    <i class="bi bi-save me-2"></i> Guardar Grupo
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar y volver</a>
            </div>
        </form>
    </div>
</div>