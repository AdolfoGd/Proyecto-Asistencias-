@using Application.DTOs
@model IEnumerable<GruposDTO>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Gestión de Grupos";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>

    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-0 text-primary">Gestión de Grupos Académicos</h2>
                <p class="text-muted mb-0">
                    @if (User.IsInRole("Administrador"))
                    {
                        <span>Control general de secciones y asignaciones (Modo Administrador)</span>
                    }
                    else
                    {
                        <span>Listado de secciones disponibles (Modo Consulta)</span>
                    }
                </p>
            </div>

            @if (User.IsInRole("Administrador"))
            {
                <a asp-controller="Grupos" asp-action="Create" class="btn btn-primary fw-bold shadow-sm">
                    <i class="bi bi-plus-lg me-1"></i> + Registrar Grupo
                </a>
            }
        </div>

        <!-- Tabla de Contenido -->
        <div class="card shadow-sm border-0 rounded-3 bg-white">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">CÓDIGO DE GRUPO</th>
                                <th>ASIGNATURA</th>
                                <th>DOCENTE ASIGNADO</th>
                                <th>SECCIÓN</th>

                                @if (User.IsInRole("Administrador"))
                                {
                                    <th class="text-end pe-4">ACCIONES</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <span class="badge bg-light text-dark border fw-bold px-3 py-2">
                                                @item.CodigoGrupo
                                            </span>
                                        </td>
                                        <td>
                                            <span class="fw-semibold text-dark">@item.IdAsignatura</span>
                                        </td>
                                        <td>
                                            <span class="text-muted">Docente ID:</span>
                                            <span class="fw-bold text-dark">@(string.IsNullOrEmpty(item.IdDocente) ? "Sin Asignar" : item.IdDocente)</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-info text-dark fw-bold">
                                                Sección @item.Seccion
                                            </span>
                                        </td>

                                        @if (User.IsInRole("Administrador"))
                                        {
                                            <td class="text-end pe-4">
                                                <a asp-controller="Grupos" asp-action="Edit" asp-route-id="@item.CodigoGrupo" class="btn btn-sm btn-outline-warning me-1 fw-bold">
                                                    Editar
                                                </a>
                                                <form asp-controller="Grupos" asp-action="Delete" asp-route-id="@item.CodigoGrupo" method="post" class="d-inline" onsubmit="return confirm('¿Estás seguro de eliminar este grupo?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger fw-bold">
                                                        Eliminar
                                                    </button>
                                                </form>
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="@(User.IsInRole("Administrador") ? 5 : 4)" class="text-center py-4 text-muted">
                                        No se encontraron registros de grupos académicos.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</body>
</html>