@model IEnumerable<Application.DTOs.EstudianteDTO>
@{
    ViewData["Title"] = "Comunidad Estudiantil";
    var totalEstudiantes = Model?.Count() ?? 0;
    var conFaltas = Model?.Count(e => e.CantidadFaltas > 0) ?? 0;
    var enRiesgo = Model?.Count(e => e.CantidadFaltas >= 4) ?? 0;
}

<div class="row align-items-center mb-4">
    <div class="col-md-7">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-primary bg-gradient text-white rounded-4 p-3 shadow-sm d-flex align-items-center justify-content-center" style="width: 58px; height: 58px;">
                <i class="bi bi-mortarboard-fill fs-2"></i>
            </div>
            <div>
                <h2 class="fw-bold text-dark mb-0">Comunidad Estudiantil</h2>
                <p class="text-muted mb-0 fs-6">Gestión académica, control de asistencia y expediente de alumnos.</p>
            </div>
        </div>
    </div>
    <div class="col-md-5 text-md-end mt-3 mt-md-0">
        <a asp-action="Nuevo" class="btn btn-primary fw-semibold px-4 py-2 shadow-sm rounded-3">
            <i class="bi bi-person-plus-fill me-2"></i> Registrar Estudiante
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3 h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-uppercase text-muted fw-bold small">Total Alumnos</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@totalEstudiantes</h3>
                </div>
                <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary">
                    <i class="bi bi-people-fill fs-3"></i>
                </div>
            </div>
            <div class="progress mt-3" style="height: 4px;">
                <div class="progress-bar bg-primary" style="width: 100%"></div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3 h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-uppercase text-muted fw-bold small">Asistencia Regular</span>
                    <h3 class="fw-bold text-success mb-0 mt-1">@(totalEstudiantes - conFaltas)</h3>
                </div>
                <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success">
                    <i class="bi bi-check-circle-fill fs-3"></i>
                </div>
            </div>
            <div class="progress mt-3" style="height: 4px;">
                <div class="progress-bar bg-success" style="width: @(totalEstudiantes > 0 ? ((totalEstudiantes - conFaltas) * 100 / totalEstudiantes) : 0)%"></div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3 h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-uppercase text-muted fw-bold small">En Riesgo / Sancionados</span>
                    <h3 class="fw-bold text-danger mb-0 mt-1">@enRiesgo</h3>
                </div>
                <div class="rounded-circle bg-danger bg-opacity-10 p-3 text-danger">
                    <i class="bi bi-exclamation-triangle-fill fs-3"></i>
                </div>
            </div>
            <div class="progress mt-3" style="height: 4px;">
                <div class="progress-bar bg-danger" style="width: @(totalEstudiantes > 0 ? (enRiesgo * 100 / totalEstudiantes) : 0)%"></div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
    <div class="card-header bg-white py-3 px-4 border-0 d-flex flex-wrap align-items-center justify-content-between gap-2">
        <span class="fw-bold text-secondary"><i class="bi bi-list-stars me-2 text-primary"></i>Padrón Oficial de Matriculados</span>

        <div class="input-group input-group-sm w-auto">
            <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
            <input type="text" id="buscarEstudiante" class="form-control bg-light border-0" placeholder="Buscar por carnet o nombre..." style="min-width: 230px;">
        </div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="tablaEstudiantes">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4 py-3">Estudiante</th>
                        <th class="py-3">Carnet</th>
                        <th class="py-3">Carrera</th>
                        <th class="py-3 text-center">Año Ingreso</th>
                        <th class="py-3 text-center">Estado / Faltas</th>
                        <th class="pe-4 py-3 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var estudiante in Model)
                        {
                            var iniciales = $"{estudiante.PrimerNombre?.FirstOrDefault()}{estudiante.PrimerApellido?.FirstOrDefault()}".ToUpper();

                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary fw-bold d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; font-size: 0.95rem;">
                                            @iniciales
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-0">@estudiante.PrimerNombre @estudiante.SegundoNombre @estudiante.PrimerApellido @estudiante.SegundoApellido</h6>
                                            <span class="text-muted small">ID Universitario</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3">
                                    <span class="badge bg-light text-dark border font-monospace px-2 py-1">@estudiante.Carnet</span>
                                </td>
                                <td class="py-3 fw-medium text-secondary">
                                    <i class="bi bi-book me-1 text-primary opacity-75"></i>@estudiante.Carrera
                                </td>
                                <td class="py-3 text-center">
                                    <span class="badge bg-info-subtle text-info-emphasis px-3 py-2 rounded-pill">
                                        <i class="bi bi-calendar3 me-1"></i>@estudiante.AñoIngreso.Year
                                    </span>
                                </td>
                                <td class="py-3 text-center">
                                    @if (estudiante.CantidadFaltas >= 4)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill fw-semibold">
                                            <i class="bi bi-exclamation-octagon-fill me-1"></i>Sancionado (@estudiante.CantidadFaltas)
                                        </span>
                                    }
                                    else if (estudiante.CantidadFaltas > 0)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 rounded-pill fw-semibold">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>@estudiante.CantidadFaltas Faltas
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-semibold">
                                            <i class="bi bi-check-circle-fill me-1"></i>Al Día (0)
                                        </span>
                                    }
                                </td>
                                <td class="pe-4 py-3 text-end">
                                    <div class="btn-group btn-group-sm shadow-sm" role="group">
                                        <a asp-action="Editar" asp-route-id="@estudiante.Carnet" class="btn btn-outline-secondary" title="Editar Registro">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                        <form asp-action="Eliminar" asp-route-id="@estudiante.Carnet" method="post" class="d-inline" onsubmit="return confirm('¿Confirma que desea eliminar este estudiante?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger border-start-0" title="Eliminar">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="py-4">
                                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center p-4 mb-3" style="width: 80px; height: 80px;">
                                        <i class="bi bi-mortarboard display-6"></i>
                                    </div>
                                    <h5 class="fw-bold text-dark">No hay estudiantes registrados</h5>
                                    <p class="text-muted small mb-3">Empiece a registrar alumnos para dar seguimiento a su historial y puntualidad.</p>
                                    <a asp-action="Nuevo" class="btn btn-primary btn-sm px-4 rounded-3 fw-semibold shadow-sm">
                                        <i class="bi bi-person-plus-fill me-1"></i> Registrar Primer Estudiante
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('buscarEstudiante')?.addEventListener('keyup', function () {
            let valor = this.value.toLowerCase();
            let filas = document.querySelectorAll('#tablaEstudiantes tbody tr');
            filas.forEach(fila => {
                let texto = fila.textContent.toLowerCase();
                fila.style.display = texto.includes(valor) ? '' : 'none';
            });
        });
    </script>
    
}