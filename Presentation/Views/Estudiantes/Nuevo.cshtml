@model Application.DTOs.EstudianteDTO
@{
    ViewData["Title"] = "Registrar Estudiante";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-0"><i class="bi bi-person-plus text-warning me-2"></i>Registrar Estudiante</h2>
        <p class="text-muted fs-6 mb-0">Ingrese los datos generales del nuevo alumno.</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3 bg-white">
    <div class="card-body p-4">
        <form asp-action="Nuevo" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">

                <!-- Carnet -->
                <div class="col-md-6">
                    <label asp-for="Carnet" class="form-label fw-semibold text-secondary">Carnet Estudiantil</label>
                    <input asp-for="Carnet" type="text" class="form-control" placeholder="Ej. 240871" required />
                </div>

                <!-- Contraseña -->
                <div class="col-md-6">
                    <label asp-for="Contraseña" class="form-label fw-semibold text-secondary">Contraseña</label>
                    <input asp-for="Contraseña" type="password" class="form-control" placeholder="******" required />
                </div>

                <!-- Primer Nombre -->
                <div class="col-md-6">
                    <label asp-for="PrimerNombre" class="form-label fw-semibold text-secondary">Primer Nombre</label>
                    <input asp-for="PrimerNombre" type="text" class="form-control" placeholder="Ej. Gustavo" required />
                </div>

                <!-- Segundo Nombre -->
                <div class="col-md-6">
                    <label asp-for="SegundoNombre" class="form-label fw-semibold text-secondary">Segundo Nombre</label>
                    <input asp-for="SegundoNombre" type="text" class="form-control" placeholder="Ej. Adolfo" />
                </div>

                <!-- Primer Apellido -->
                <div class="col-md-6">
                    <label asp-for="PrimerApellido" class="form-label fw-semibold text-secondary">Primer Apellido</label>
                    <input asp-for="PrimerApellido" type="text" class="form-control" placeholder="Ej. Dávila" required />
                </div>

                <!-- Segundo Apellido -->
                <div class="col-md-6">
                    <label asp-for="SegundoApellido" class="form-label fw-semibold text-secondary">Segundo Apellido</label>
                    <input asp-for="SegundoApellido" type="text" class="form-control" placeholder="Ej. Maradiaga" />
                </div>

                <!-- Carrera -->
                <div class="col-md-6">
                    <label asp-for="Carrera" class="form-label fw-semibold text-secondary">Carrera Universitaria</label>
                    <input asp-for="Carrera" type="text" class="form-control" placeholder="Ej. Ingeniería en Sistemas" required />
                </div>

                <!-- Fecha de Ingreso -->
                <div class="col-md-6">
                    <label asp-for="AñoIngreso" class="form-label fw-semibold text-secondary">Fecha / Año de Ingreso</label>
                    <input asp-for="AñoIngreso" type="date" class="form-control" required />
                </div>

            </div>

            <hr class="my-4 text-muted" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning fw-bold px-4">
                    <i class="bi bi-save me-2"></i> Guardar Estudiante
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar y volver</a>
            </div>
        </form>
    </div>
</div>