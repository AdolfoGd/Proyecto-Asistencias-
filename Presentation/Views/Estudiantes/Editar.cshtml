@model Domain.Entities.Estudiante

@{
    ViewData["Title"] = "Editar Estudiante";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-0"><i class="bi bi-pencil-square text-warning me-2"></i>Editar Estudiante</h2>
        <p class="text-muted fs-6 mb-0">Actualice la información del estudiante seleccionado.</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3 bg-white">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">

                <!-- Carnet (Solo lectura) -->
                <div class="col-md-6">
                    <label asp-for="Carnet" class="form-label fw-semibold text-secondary">Carnet Estudiantil</label>
                    <input asp-for="Carnet" type="text" class="form-control bg-light" readonly />
                </div>

                <!-- Contraseña -->
                <div class="col-md-6">
                    <label asp-for="Contraseña" class="form-label fw-semibold text-secondary">Contraseña</label>
                    <input asp-for="Contraseña" type="text" class="form-control" required />
                    <span asp-validation-for="Contraseña" class="text-danger small"></span>
                </div>

                <!-- Primer Nombre -->
                <div class="col-md-6">
                    <label asp-for="PrimerNombre" class="form-label fw-semibold text-secondary">Primer Nombre</label>
                    <input asp-for="PrimerNombre" type="text" class="form-control" required />
                    <span asp-validation-for="PrimerNombre" class="text-danger small"></span>
                </div>

                <!-- Segundo Nombre -->
                <div class="col-md-6">
                    <label asp-for="SegundoNombre" class="form-label fw-semibold text-secondary">Segundo Nombre</label>
                    <input asp-for="SegundoNombre" type="text" class="form-control" />
                    <span asp-validation-for="SegundoNombre" class="text-danger small"></span>
                </div>

                <!-- Primer Apellido -->
                <div class="col-md-6">
                    <label asp-for="PrimerApellido" class="form-label fw-semibold text-secondary">Primer Apellido</label>
                    <input asp-for="PrimerApellido" type="text" class="form-control" required />
                    <span asp-validation-for="PrimerApellido" class="text-danger small"></span>
                </div>

                <!-- Segundo Apellido -->
                <div class="col-md-6">
                    <label asp-for="SegundoApellido" class="form-label fw-semibold text-secondary">Segundo Apellido</label>
                    <input asp-for="SegundoApellido" type="text" class="form-control" />
                    <span asp-validation-for="SegundoApellido" class="text-danger small"></span>
                </div>

                <!-- Carrera -->
                <div class="col-md-4">
                    <label asp-for="Carrera" class="form-label fw-semibold text-secondary">Carrera Universitaria</label>
                    <input asp-for="Carrera" type="text" class="form-control" required />
                    <span asp-validation-for="Carrera" class="text-danger small"></span>
                </div>

                <!-- Fecha / Año Ingreso -->
                <div class="col-md-4">
                    <label asp-for="AñoIngreso" class="form-label fw-semibold text-secondary">Año de Ingreso</label>
                    <input asp-for="AñoIngreso" type="date" class="form-control" required />
                    <span asp-validation-for="AñoIngreso" class="text-danger small"></span>
                </div>

                <!-- Cantidad de Faltas -->
                <div class="col-md-4">
                    <label asp-for="CantidadFaltas" class="form-label fw-semibold text-secondary">Cantidad de Faltas</label>
                    <input asp-for="CantidadFaltas" type="number" min="0" class="form-control" required />
                    <span asp-validation-for="CantidadFaltas" class="text-danger small"></span>
                </div>

            </div>

            <hr class="my-4 text-muted" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning fw-bold px-4">
                    <i class="bi bi-check-circle me-2"></i> Guardar Cambios
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
            </div>
        </form>
    </div>
</div>