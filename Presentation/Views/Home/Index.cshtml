@{
    ViewData["Title"] = "Inicio";
}

<div class="container py-4">
    <!-- Banner de Bienvenida -->
    <div class="p-4 p-md-5 mb-4 rounded-4 text-white shadow-lg" style="background-color: #2563eb;">
        <h1 class="fw-bold display-6">¡Bienvenido, @User.Identity?.Name!</h1>
        <p class="fs-5 mb-0 opacity-90">
            @if (User.IsInRole("Empleado"))
            {
                <span>Panel de Administración Central. Gestiona empleados, docentes, estudiantes, matrículas, grupos, sesiones de clases y asistencias.</span>
            }
            else if (User.IsInRole("Docente"))
            {
                <span>Portal Docente. Gestiona tus asignaciones docentes, grupos de clases, sesiones y registro de asistencias.</span>
            }
            else
            {
                <span>Portal Estudiantil. Consulta tus datos de estudiante, asignaturas matriculadas, grupos, sesiones y registro de asistencias.</span>
            }
        </p>
    </div>

    <!-- Módulos del Sistema -->
    <div class="row g-4">

        <!-- 1. Empleados (Solo Empleado) -->
        @if (User.IsInRole("Empleado"))
        {
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-3" style="background-color: #1e293b; color: #e2e8f0; border: 1px solid #334155 !important;">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <div class="fs-1 mb-2">👤</div>
                            <h4 class="fw-bold text-white">Empleados</h4>
                            <p class="text-secondary small">Gestión del personal administrativo del sistema.</p>
                        </div>
                        <a href="/Empleados" class="btn btn-primary w-100 fw-semibold mt-3">Ver Empleados</a>
                    </div>
                </div>
            </div>
        }

        <!-- 2. Docentes (Empleado y Docente) -->
        @if (User.IsInRole("Empleado") || User.IsInRole("Docente"))
        {
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-3" style="background-color: #1e293b; color: #e2e8f0; border: 1px solid #334155 !important;">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <div class="fs-1 mb-2">👨‍🏫</div>
                            <h4 class="fw-bold text-white">Docentes</h4>
                            <p class="text-secondary small">Consulta y administración del cuerpo docente.</p>
                        </div>
                        <a href="/Docentes" class="btn btn-success w-100 fw-semibold mt-3">Ver Docentes</a>
                    </div>
                </div>
            </div>
        }

        <!-- 3. Estudiantes (Empleado y Estudiante) -->
        @if (User.IsInRole("Empleado") || User.IsInRole("Estudiante"))
        {
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-3" style="background-color: #1e293b; color: #e2e8f0; border: 1px solid #334155 !important;">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <div class="fs-1 mb-2">👥</div>
                            <h4 class="fw-bold text-white">Estudiantes</h4>
                            <p class="text-secondary small">Consulta el listado general e información de estudiantes.</p>
                        </div>
                        <a href="/Estudiantes" class="btn btn-primary w-100 fw-semibold mt-3">Ver Estudiantes</a>
                    </div>
                </div>
            </div>

            <!-- 4. Matrículas (Empleado y Estudiante) -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-3" style="background-color: #1e293b; color: #e2e8f0; border: 1px solid #334155 !important;">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <div class="fs-1 mb-2">🎓</div>
                            <h4 class="fw-bold text-white">Matrículas</h4>
                            <p class="text-secondary small">Registro y control de matrículas por grupo.</p>
                        </div>
                        <a href="/Matriculas" class="btn btn-info text-white w-100 fw-semibold mt-3">Ver Matrículas</a>
                    </div>
                </div>
            </div>
        }

        <!-- 5. Grupos (Todos los Roles) -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-3" style="background-color: #1e293b; color: #e2e8f0; border: 1px solid #334155 !important;">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="fs-1 mb-2">🏫</div>
                        <h4 class="fw-bold text-white">Grupos</h4>
                        <p class="text-secondary small">Listado de grupos académicos y asignaciones de secciones.</p>
                    </div>
                    <a href="/Grupos" class="btn btn-secondary w-100 fw-semibold mt-3">Ver Grupos</a>
                </div>
            </div>
        </div>

        <!-- 6. Sesiones de Clase (Todos los Roles) -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-3" style="background-color: #1e293b; color: #e2e8f0; border: 1px solid #334155 !important;">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="fs-1 mb-2">📖</div>
                        <h4 class="fw-bold text-white">Sesiones de Clase</h4>
                        <p class="text-secondary small">Programación y gestión de sesiones impartidas.</p>
                    </div>
                    <a href="/SesionDeClase" class="btn btn-dark border border-secondary w-100 fw-semibold mt-3">Ver Sesiones</a>
                </div>
            </div>
        </div>

        <!-- 7. Asistencias (Todos los Roles) -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-3" style="background-color: #1e293b; color: #e2e8f0; border: 1px solid #334155 !important;">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="fs-1 mb-2">📅</div>
                        <h4 class="fw-bold text-white">Asistencias</h4>
                        <p class="text-secondary small">Control diario y registro de inasistencias y faltas.</p>
                    </div>
                    <a href="/Asistencias" class="btn btn-warning text-dark w-100 fw-semibold mt-3">Ver Asistencias</a>
                </div>
            </div>
        </div>

    </div>
</div>