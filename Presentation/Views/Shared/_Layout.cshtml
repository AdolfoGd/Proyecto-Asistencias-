<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema Universitario</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background-color: #0f172a; color: #e2e8f0;">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom box-shadow mb-3" style="background-color: #1e293b !important; border-color: #334155 !important;">
            <div class="container-fluid">
                <a class="navbar-brand text-white fw-bold" href="/Home">Sistema Universitario</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- Menú de Navegación según Rol -->
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/Home">Inicio</a>
                        </li>

                        <!-- 1. Solo Empleados -->
                        @if (User.IsInRole("Empleado"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" href="/Empleados">Empleados</a>
                            </li>
                        }

                        <!-- 2. Empleados y Docentes -->
                        @if (User.IsInRole("Empleado") || User.IsInRole("Docente"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" href="/Docentes">Docentes</a>
                            </li>
                        }

                        <!-- 3. Empleados y Estudiantes -->
                        @if (User.IsInRole("Empleado") || User.IsInRole("Estudiante"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" href="/Estudiantes">Estudiantes</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" href="/Matriculas">Matrículas</a>
                            </li>
                        }

                        <!-- 4. Visibles para Todos los Roles -->
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/Grupos">Grupos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/SesionDeClase">Sesiones</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/Asistencias">Asistencias</a>
                        </li>
                    </ul>

                    <!-- Sección de Usuario / Cerrar Sesión -->
                    <div class="d-flex align-items-center gap-3">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <span class="text-light small">
                                👤 <strong>@User.Identity.Name</strong>
                                <span class="badge bg-secondary ms-1">
                                    @(User.IsInRole("Empleado") ? "Empleado" : User.IsInRole("Docente") ? "Docente" : "Estudiante")
                                </span>
                            </span>
                            <a href="/Account/Logout" class="btn btn-sm btn-outline-danger">Cerrar Sesión</a>
                        }
                        else
                        {
                            <a href="/Account/Login" class="btn btn-sm btn-primary">Iniciar Sesión</a>
                        }
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <!-- Contenido Principal -->
    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>