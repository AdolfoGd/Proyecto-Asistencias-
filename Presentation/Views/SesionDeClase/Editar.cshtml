@model Application.DTOs.Sesion_de_ClaseDTO

@{
    ViewData["Title"] = "Editar Sesión de Clase";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden" style="background-color: #1e293b; border: 1px solid #334155 !important;">
                <div class="card-header py-3 px-4 border-bottom" style="background-color: #1e293b; border-color: #334155 !important;">
                    <h4 class="fw-bold text-white mb-1">Editar Sesión de Clase</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Editar" method="post">
                        <div asp-validation-summary="All" class="text-danger mb-3 small"></div>
                        <input type="hidden" asp-for="IdSesion" />

                        <div class="mb-3">
                            <label asp-for="CodigoGrupo" class="form-label text-light fw-semibold"></label>
                            <input asp-for="CodigoGrupo" type="number" class="form-control text-white" style="background-color: #0f172a; border-color: #334155;" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="TemaImpartido" class="form-label text-light fw-semibold"></label>
                            <input asp-for="TemaImpartido" class="form-control text-white" style="background-color: #0f172a; border-color: #334155;" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="FechaHoraInicio" class="form-label text-light fw-semibold"></label>
                            <input asp-for="FechaHoraInicio" type="datetime-local" class="form-control text-white" style="background-color: #0f172a; border-color: #334155; color-scheme: dark;" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="FechaHoraFin" class="form-label text-light fw-semibold"></label>
                            <input asp-for="FechaHoraFin" type="datetime-local" class="form-control text-white" style="background-color: #0f172a; border-color: #334155; color-scheme: dark;" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-light fw-semibold">Sección</label>
                            <input type="text" class="form-control text-secondary" value="@Model.Seccion" disabled style="background-color: #0f172a; border-color: #334155;" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label text-light fw-semibold">Departamento</label>
                            <input type="text" class="form-control text-secondary" value="@Model.Departamento" disabled style="background-color: #0f172a; border-color: #334155;" />
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-2">
                            <a asp-action="Index" class="btn btn-outline-light px-3 fw-semibold">Cancelar</a>
                            <button type="submit" class="btn btn-warning px-4 fw-semibold shadow-sm">Guardar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
