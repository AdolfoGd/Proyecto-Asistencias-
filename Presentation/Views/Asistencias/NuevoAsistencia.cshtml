@model Application.DTOs.AsistenciaDTO
@{
    ViewData["Title"] = "Nueva Asistencia";
}

<h2>Registrar Nueva Asistencia</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="NuevoAsistencia" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <div class="form-group mb-3">
                <label asp-for="IdSesion" class="control-label">ID de Sesión</label>
                <input asp-for="IdSesion" type="number" class="form-control" placeholder="Ej. 101" required />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Carnet" class="control-label">Carnet del Usuario</label>
                <input asp-for="Carnet" type="number" class="form-control" placeholder="Ej. 2024001" required />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Estado" class="control-label">Estado</label>
                <select asp-for="Estado" class="form-select">
                    <option value="">Seleccione un estado...</option>
                    <option value="Presente">Presente</option>
                    <option value="Ausente">Ausente</option>
                    <option value="Tarde">Tarde</option>
                </select>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Hora_Registro" class="control-label">Hora de Registro</label>
                <input asp-for="Hora_Registro" type="time" class="form-control" required />
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Guardar Registro</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar y volver a la lista</a>
            </div>

        </form>
    </div>
</div>
