@model IEnumerable<Application.DTOs.AsistenciaDTO>
    

@{
    ViewData["Title"] = "Asistencias";
}


<h2>Asistencias</h2>
<section class="row">
    <aside class="col-lg-12">
        <div class="mb-3">
            <a asp-action="NuevoAsistencia" class="btn btn-success">
                + Registrar Nueva Asistencia
            </a>
            <form asp-action="Index" method="get" class="d-flex gap-2">
                <input type="number"
                       name="idSesion"
                       class="form-control"
                       placeholder="Buscar por ID Sesión..."
                       value="@ViewBag.IdSesionBuscada"
                       style="width: 220px;" />

                <button type="submit" class="btn btn-primary">Filtrar</button>

                @if (ViewBag.IdSesionBuscada != null)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Ver Todas</a>
                }
            </form>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID Sesión</th>
                        <th>Carnet Usuario</th>
                        <th>Estado</th>
                        <th>Hora de Registro</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.IdSesion</strong></td>
                                <td>@item.Carnet</td>
                                <td>
                                    <span class="badge @(item.Estado == "Presente" ? "bg-success" : item.Estado == "Tarde" ? "bg-warning text-dark" : "bg-danger")">
                                        @item.Estado
                                    </span>
                                </td>
                                <td>@item.Hora_Registro</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                No se encontraron registros de asistencia para esta consulta.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>