@model Application.DTOs.MatriculasDTO

@{
    ViewData["Title"] = "Registrar Nueva Matrícula";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden" style="background-color: #1e293b; border: 1px solid #334155 !important;">
                <div class="card-header py-3 px-4 border-bottom" style="background-color: #1e293b; border-color: #334155 !important;">
                    <h4 class="fw-bold text-white mb-1">Registrar Nueva Matrícula</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="NuevaMatricula" method="post">
                        <div asp-validation-summary="All" class="text-danger mb-3 small"></div>

                        <div class="mb-3">
                            <label asp-for="IdEstudiante" class="form-label text-light fw-semibold"></label>
                            <input asp-for="IdEstudiante" type="number" class="form-control text-white" style="background-color: #0f172a; border-color: #334155;" />
                        </div>
                        <div class="mb-4">
                            <label asp-for="CodigoGrupo" class="form-label text-light fw-semibold"></label>
                            <input asp-for="CodigoGrupo" class="form-control text-white" style="background-color: #0f172a; border-color: #334155;" />
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-2">
                            <a asp-action="Index" class="btn btn-outline-light px-3 fw-semibold">Cancelar</a>
                            <button type="submit" class="btn btn-success px-4 fw-semibold shadow-sm">Guardar Registro</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

