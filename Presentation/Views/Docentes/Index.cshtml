@model IEnumerable<Domain.Entities.Docentes>

@{
    ViewData["Title"] = "Directorio de Docentes";
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0 text-success">Directorio de Docentes</h2>
            <p class="text-muted mb-0">
                @if (User.IsInRole("Administrador"))
                {
                    <span>Administre el personal académico, asigne departamentos y revise su récord.</span>
                }
                else
                {
                    <span>Consulte el listado del personal académico (Modo Consulta)</span>
                }
            </p>
        </div>

        @if (User.IsInRole("Administrador"))
        {
            <a asp-action="Create" class="btn btn-success fw-bold">
                + Registrar Docente
            </a>
        }
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">CARNET</th>
                            <th>NOMBRE COMPLETO</th>
                            <th>CÓD. EMPLEADO</th>
                            <th>DEPARTAMENTO</th>
                            <th>FALTAS</th>

                            @if (User.IsInRole("Administrador"))
                            {
                                <th class="text-end pe-4">ACCIONES</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="badge bg-light text-dark border fw-bold">@item.Carnet</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center me-3 fw-bold" style="width: 36px; height: 36px;">
                                                @(item.PrimerNombre?.Substring(0, 1))@(item.PrimerApellido?.Substring(0, 1))
                                            </div>
                                            <div>
                                                <div class="fw-bold">@item.PrimerNombre @item.SegundoNombre @item.PrimerApellido @item.SegundoApellido</div>
                                                <small class="text-muted">Docente Universitario</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="fw-semibold">@item.CodigoEmpleado</span></td>
                                    <td>@item.Departamento</td>
                                    <td>
                                        <span class="badge @(item.CantidadFaltas > 0 ? "bg-warning text-dark" : "bg-success")">
                                            @item.CantidadFaltas Faltas
                                        </span>
                                    </td>

                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <td class="text-end pe-4">
                                            <a asp-action="Edit" asp-route-id="@item.Carnet" class="btn btn-sm btn-outline-warning me-1 fw-bold">
                                                Editar
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@item.Carnet" method="post" class="d-inline" onsubmit="return confirm('¿Estás seguro de eliminar este docente?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger fw-bold">
                                                    Eliminar
                                                </button>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@(User.IsInRole("Administrador") ? 6 : 5)" class="text-center py-4 text-muted">
                                    No hay docentes registrados en el sistema.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>