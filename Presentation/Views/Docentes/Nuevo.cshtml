@model Domain.Entities.Docentes

@{
    ViewData["Title"] = "Registrar Docente";
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0">
                <i class="bi bi-person-plus text-success me-2"></i>Registrar Nuevo Docente
            </h2>
            <p class="text-muted fs-6 mb-0">Los datos ingresados se registrarán directamente en la base de datos.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3 bg-white">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <!-- Carnet -->
                    <div class="col-md-6">
                        <label asp-for="Carnet" class="form-label fw-semibold text-secondary">Carnet</label>
                        <input asp-for="Carnet" type="text" class="form-control" placeholder="Ej. D-240104" required />
                        <span asp-validation-for="Carnet" class="text-danger small"></span>
                    </div>

                    <!-- Contraseña -->
                    <div class="col-md-6">
                        <label asp-for="Contraseña" class="form-label fw-semibold text-secondary">Contraseña</label>
                        <input asp-for="Contraseña" type="password" class="form-control" placeholder="••••••••" required />
                        <span asp-validation-for="Contraseña" class="text-danger small"></span>
                    </div>

                    <!-- Código Empleado -->
                    <div class="col-md-6">
                        <label asp-for="CodigoEmpleado" class="form-label fw-semibold text-secondary">Código de Empleado</label>
                        <input asp-for="CodigoEmpleado" type="text" class="form-control" placeholder="Ej. D004" required />
                        <span asp-validation-for="CodigoEmpleado" class="text-danger small"></span>
                    </div>

                    <!-- Departamento -->
                    <div class="col-md-6">
                        <label asp-for="Departamento" class="form-label fw-semibold text-secondary">Departamento Asignado</label>
                        <select asp-for="Departamento" class="form-select" required>
                            <option value="">Seleccione un departamento...</option>
                            <option value="Ingeniería en Sistema">Ingeniería en Sistema</option>
                            <option value="Finanzas">Finanzas</option>
                            <option value="Administración">Administración</option>
                            <option value="Ciencias Básicas">Ciencias Básicas</option>
                        </select>
                        <span asp-validation-for="Departamento" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PrimerNombre" class="form-label fw-semibold text-secondary">Primer Nombre</label>
                        <input asp-for="PrimerNombre" type="text" class="form-control" placeholder="Ej. Steven" required />
                        <span asp-validation-for="PrimerNombre" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="SegundoNombre" class="form-label fw-semibold text-secondary">Segundo Nombre</label>
                        <input asp-for="SegundoNombre" type="text" class="form-control" placeholder="Ej. Jizmeth" required />
                        <span asp-validation-for="SegundoNombre" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PrimerApellido" class="form-label fw-semibold text-secondary">Primer Apellido</label>
                        <input asp-for="PrimerApellido" type="text" class="form-control" placeholder="Ej. Gustavo" required />
                        <span asp-validation-for="PrimerApellido" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="SegundoApellido" class="form-label fw-semibold text-secondary">Segundo Apellido</label>
                        <input asp-for="SegundoApellido" type="text" class="form-control" placeholder="Ej. Victor" required />
                        <span asp-validation-for="SegundoApellido" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="CantidadFaltas" class="form-label fw-semibold text-secondary">Cantidad Inicial de Faltas</label>
                        <input asp-for="CantidadFaltas" type="number" class="form-control" value="0" min="0" required />
                        <span asp-validation-for="CantidadFaltas" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4 text-muted" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success fw-bold px-4">
                        <i class="bi bi-save me-2"></i> Guardar en Base de Datos
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar y volver</a>
                </div>
            </form>
        </div>
    </div>
</div>