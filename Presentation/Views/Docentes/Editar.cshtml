@model Domain.Entities.Docentes

@{
    ViewData["Title"] = "Editar Docente";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-0">
            <i class="bi bi-pencil-square text-warning me-2"></i>Editar Docente
        </h2>
        <p class="text-muted fs-6 mb-0">Modifique los datos del registro para guardarlos en la base de datos.</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3 bg-white">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()

            <div class="row g-4">

                <!-- Carnet (Llave primaria / Solo lectura) -->
                <div class="col-md-6">
                    <label asp-for="Carnet" class="form-label fw-semibold text-secondary">Carnet</label>
                    <input asp-for="Carnet" type="text" class="form-control bg-light" readonly />
                </div>

                <!-- Contraseña -->
                <div class="col-md-6">
                    <label asp-for="Contraseña" class="form-label fw-semibold text-secondary">Contraseña</label>
                    <input asp-for="Contraseña" type="text" class="form-control" required />
                    <span asp-validation-for="Contraseña" class="text-danger small"></span>
                </div>

                <!-- Código Empleado -->
                <div class="col-md-6">
                    <label asp-for="CodigoEmpleado" class="form-label fw-semibold text-secondary">Código de Empleado</label>
                    <input asp-for="CodigoEmpleado" type="text" class="form-control" required />
                    <span asp-validation-for="CodigoEmpleado" class="text-danger small"></span>
                </div>

                <!-- Departamento -->
                <div class="col-md-6">
                    <label asp-for="Departamento" class="form-label fw-semibold text-secondary">Departamento Asignado</label>
                    <select asp-for="Departamento" class="form-select" required>
                        <option value="">Seleccione un departamento...</option>
                        <option value="Ingeniería en Sistema">Ingeniería en Sistema</option>
                        <option value="Finanzas">Finanzas</option>
                        <option value="Administración">Administración</option>
                        <option value="Ciencias Básicas">Ciencias Básicas</option>
                    </select>
                    <span asp-validation-for="Departamento" class="text-danger small"></span>
                </div>

                <!-- Primer Nombre -->
                <div class="col-md-6">
                    <label asp-for="PrimerNombre" class="form-label fw-semibold text-secondary">Primer Nombre</label>
                    <input asp-for="PrimerNombre" type="text" class="form-control" required />
                    <span asp-validation-for="PrimerNombre" class="text-danger small"></span>
                </div>

                <!-- Segundo Nombre -->
                <div class="col-md-6">
                    <label asp-for="SegundoNombre" class="form-label fw-semibold text-secondary">Segundo Nombre</label>
                    <input asp-for="SegundoNombre" type="text" class="form-control" required />
                    <span asp-validation-for="SegundoNombre" class="text-danger small"></span>
                </div>

                <!-- Primer Apellido -->
                <div class="col-md-6">
                    <label asp-for="PrimerApellido" class="form-label fw-semibold text-secondary">Primer Apellido</label>
                    <input asp-for="PrimerApellido" type="text" class="form-control" required />
                    <span asp-validation-for="PrimerApellido" class="text-danger small"></span>
                </div>

                <!-- Segundo Apellido -->
                <div class="col-md-6">
                    <label asp-for="SegundoApellido" class="form-label fw-semibold text-secondary">Segundo Apellido</label>
                    <input asp-for="SegundoApellido" type="text" class="form-control" required />
                    <span asp-validation-for="SegundoApellido" class="text-danger small"></span>
                </div>

                <!-- Cantidad de Faltas -->
                <div class="col-md-12">
                    <label asp-for="CantidadFaltas" class="form-label fw-semibold text-secondary">Cantidad de Faltas</label>
                    <input asp-for="CantidadFaltas" type="number" class="form-control" min="0" required />
                    <span asp-validation-for="CantidadFaltas" class="text-danger small"></span>
                </div>

            </div>

            <hr class="my-4 text-muted" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning fw-bold px-4">
                    <i class="bi bi-check-circle me-2"></i> Guardar Cambios
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
            </div>
        </form>
    </div>
</div>