@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null; // Sin menú de navegación en la pantalla de Login
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema Universitario</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body style="background-color: #0f172a; color: #e2e8f0; height: 100vh; display: flex; align-items: center; justify-content: center;">

    <div class="card border-0 shadow-lg rounded-4 p-4" style="background-color: #1e293b; border: 1px solid #334155 !important; width: 100%; max-width: 400px;">

        <div class="text-center mb-4">
            <h3 class="fw-bold text-white">Bienvenido</h3>
            <p class="text-secondary small">Ingrese sus credenciales para acceder</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 text-center small fw-semibold" role="alert">
                @ViewBag.Error
            </div>
        }

        <form asp-action="Login" method="post">
            <div class="mb-3">
                <label for="usuario" class="form-label text-secondary small fw-bold">Carnet / Código de Empleado</label>
                <input type="text" class="form-control text-white" id="usuario" name="usuario" required
                       style="background-color: #0f172a; border-color: #334155;" placeholder="Ej. 2024-0001" />
            </div>

            <div class="mb-4">
                <label for="password" class="form-label text-secondary small fw-bold">Contraseña</label>
                <input type="password" class="form-control text-white" id="password" name="password" required
                       style="background-color: #0f172a; border-color: #334155;" placeholder="********" />
            </div>

            <button type="submit" class="btn btn-primary w-100 fw-bold py-2">Ingresar al Sistema</button>
        </form>
    </div>

</body>
</html>
