@model Presentation.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Control Universitario</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light d-flex align-items-center" style="height: 100vh;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="card shadow-sm border-0 rounded-lg mt-5">
                    <div class="card-header bg-primary text-white text-center">
                        <h3 class="font-weight-light my-2">Acceso a Estudiantes</h3>
                    </div>
                    <div class="card-body">
                        <form asp-action="Login" method="post">
                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="form-floating mb-3">
                                <input asp-for="Carnet" class="form-control" placeholder="Ej: 240871" required />
                                <label asp-for="Carnet">Número de Carnet</label>
                                <span asp-validation-for="Carnet" class="text-danger"></span>
                            </div>

                            <div class="form-floating mb-3">
                                <input asp-for="Contrasena" class="form-control" type="password" placeholder="Contraseña" required />
                                <label asp-for="Contrasena">Contraseña</label>
                                <span asp-validation-for="Contrasena" class="text-danger"></span>
                            </div>

                            <div class="d-flex align-items-center justify-content-between mt-4 mb-0">
                                <button type="submit" class="btn btn-primary w-100">Iniciar Sesión</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>